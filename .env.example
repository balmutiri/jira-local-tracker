# Copy this file to .env, then replace the Jira placeholders.
# These values are intentionally fake and safe to commit.
JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=example@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_JQL=assignee = currentUser() ORDER BY updated DESC

# Optional: leave blank to use local status insights instead of OpenAI.
OPENAI_API_KEY=

# Optional: the local server port.
PORT=4000